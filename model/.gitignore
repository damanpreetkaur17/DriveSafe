# Python / Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual Environments
.venv/
venv/
env/
ENV/

# Model weights & large binary files
*.dat
*.task
*.pth
*.pt
*.h5
*.hdf5
*.onnx
*.tflite
*.pb
*.bin
*.weights
*.caffemodel
*.pkl
*.joblib

# Large Media (Video & Audio)
*.mp4
*.avi
*.mov
*.mkv
*.gif
*.mp3

# Datasets & Archives
dataset/
*.zip
*.tar.gz
*.rar
*.7z

# Logs & Runtime Output
logs/*.log
runs/*
!runs/.gitkeep

# Generated Results (keep structure)
results/plots/*
!results/plots/.gitkeep
results/confusion_matrix/*
!results/confusion_matrix/.gitkeep
results/metrics/*
!results/metrics/.gitkeep
results/predictions/*
!results/predictions/.gitkeep

# IDE & System Files
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
