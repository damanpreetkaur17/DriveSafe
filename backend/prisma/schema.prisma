generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  user_id            Int                @id @default(autoincrement())
  username           String             @unique
  email              String             @unique
  password_hash      String
  created_at         DateTime           @default(now())
  updated_at         DateTime           @updatedAt
  profile_completed  Boolean            @default(false)
  driving_sessions   DrivingSession[]
  emergency_contacts EmergencyContact[]
  profile            Profile?
  vehicles           Vehicle[]
}

model Profile {
  user_id       Int       @id
  full_name     String
  phone         String?
  date_of_birth DateTime?
  gender        String?
  address       String?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  user          User      @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
}

model Vehicle {
  vehicle_id         Int              @id @default(autoincrement())
  user_id            Int
  registration_no    String           @unique
  vehicle_type       String
  make               String
  model              String
  manufacturing_year Int
  created_at         DateTime         @default(now())
  updated_at         DateTime         @updatedAt
  driving_sessions   DrivingSession[]
  user               User             @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id])
}

model EmergencyContact {
  contact_id   Int      @id @default(autoincrement())
  user_id      Int
  name         String
  phone        String
  relationship String
  priority     Int      @default(1)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  alerts       Alert[]
  user         User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id])
}

model DrivingSession {
  session_id     Int            @id @default(autoincrement())
  user_id        Int
  vehicle_id     Int
  start_time     DateTime       @default(now())
  end_time       DateTime?
  status         String         @default("ACTIVE")
  created_at     DateTime       @default(now())
  user           User           @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  vehicle        Vehicle        @relation(fields: [vehicle_id], references: [vehicle_id], onDelete: Cascade)
  detection_samples DetectionSample[]
  fatigue_events FatigueEvent[]

  @@index([user_id])
  @@index([vehicle_id])
  @@index([user_id, status])
}

model DetectionSample {
  sample_id        Int            @id @default(autoincrement())
  session_id       Int
  timestamp        DateTime       @default(now())
  has_face         Boolean
  eye_status       String
  ear              Float?
  yawn_detected    Boolean?
  mouth_ratio      Float?
  head_pitch       Float?
  head_yaw         Float?
  head_roll        Float?
  attention_status String
  drowsiness_level String
  fatigue_score    Int?
  session          DrivingSession @relation(fields: [session_id], references: [session_id], onDelete: Cascade)

  @@index([session_id, timestamp])
}

model FatigueEventType {
  event_type_id  Int            @id @default(autoincrement())
  event_name     String         @unique
  created_at     DateTime       @default(now())
  fatigue_events FatigueEvent[]
}

model FatigueEvent {
  event_id      Int              @id @default(autoincrement())
  session_id    Int
  event_type_id Int
  confidence    Float?
  severity      String
  timestamp     DateTime         @default(now())
  duration      Int?
  snapshot_url  String?
  created_at    DateTime         @default(now())
  alerts        Alert[]
  event_type    FatigueEventType @relation(fields: [event_type_id], references: [event_type_id])
  session       DrivingSession   @relation(fields: [session_id], references: [session_id], onDelete: Cascade)

  @@index([session_id])
  @@index([event_type_id])
}

model Alert {
  alert_id   Int               @id @default(autoincrement())
  event_id   Int
  contact_id Int?
  alert_type String
  message    String
  sent_at    DateTime?
  status     String            @default("PENDING")
  created_at DateTime          @default(now())
  contact    EmergencyContact? @relation(fields: [contact_id], references: [contact_id])
  event      FatigueEvent      @relation(fields: [event_id], references: [event_id], onDelete: Cascade)

  @@index([event_id])
  @@index([contact_id])
}
