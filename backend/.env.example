DATABASE_URL="postgresql://user:password@neon-hostname.neon.tech/database_name?sslmode=require"
JWT_SECRET="your_long_random_secret_key_here_minimum_32_characters"
PORT=5000

# Comma-separated list of allowed frontend origins (CORS).
# Add your Vercel deployment URL here, e.g.:
#   CLIENT_URL="http://localhost:3000,https://your-app.vercel.app"
CLIENT_URL="http://localhost:3000"

NODE_ENV="development"

# Google OAuth — same Client ID used by the frontend.
# Required for POST /api/auth/google to verify ID tokens.
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
